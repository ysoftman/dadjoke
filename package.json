{
  "name": "dadjoke",
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "dev": "PUBLIC_APP_VERSION=\"$(bun version.ts)\" bun ./index.html",
    "build": "rm -rf docs && PUBLIC_APP_VERSION=\"$(bun version.ts)\" bun build ./index.html --outdir docs --minify --env \"PUBLIC_*\"",
    "preview": "bun ./docs/index.html"
  },
  "type": "module"
}
